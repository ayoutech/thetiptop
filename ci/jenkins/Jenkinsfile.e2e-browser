// Pipeline dédié : 6b. Tests end-to-end (navigateur Chromium)
// Job Jenkins : ttt-test-6b-e2e-navigateur  (créé par ci/jenkins/create-jobs.sh, appelé par le Jenkinsfile principal)
pipeline {
    agent any
    parameters {
        string(name: 'BRANCH', defaultValue: 'develop', description: 'Branche à tester')
    }
    options {
        timeout(time: 40, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('6b. Tests end-to-end (navigateur Chromium)') {
            steps {
                sh 'sh ci/run-browser-tests.sh'
            }
        }
    }
    post {
        always {
            script {
                try { junit allowEmptyResults: true, testResults: 'reports/e2e-browser.xml' }
                catch (Throwable e) { echo "Rapport JUnit non publié (${e.message})" }
            }
        }
    }
}
