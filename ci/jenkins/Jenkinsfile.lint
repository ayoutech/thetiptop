// Pipeline dédié : 1. Qualité : lint PHP
// Job Jenkins : ttt-test-1-lint  (créé par ci/jenkins/create-jobs.sh, appelé par le Jenkinsfile principal)
pipeline {
    agent any
    parameters {
        string(name: 'BRANCH', defaultValue: 'develop', description: 'Branche à tester')
    }
    options {
        timeout(time: 40, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('1. Qualité : lint PHP') {
            steps {
                sh 'sh ci/run-suite.sh lint'
            }
        }
    }
}
