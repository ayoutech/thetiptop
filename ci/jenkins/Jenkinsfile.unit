// Pipeline dédié : 2. Tests unitaires
// Job Jenkins : ttt-test-2-unitaires  (créé par ci/jenkins/create-jobs.sh, appelé par le Jenkinsfile principal)
pipeline {
    agent any
    parameters {
        string(name: 'BRANCH', defaultValue: 'develop', description: 'Branche à tester')
    }
    options {
        timeout(time: 40, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    stages {
        stage('Checkout') {
            steps { checkout scm }
        }
        stage('2. Tests unitaires') {
            steps {
                sh 'sh ci/run-suite.sh unit'
            }
        }
    }
    post {
        always {
            script {
                try { junit allowEmptyResults: true, testResults: 'reports/unit.xml' }
                catch (Throwable e) { echo "Rapport JUnit non publié (${e.message})" }
            }
        }
    }
}
