<?xml version="1.0" encoding="UTF-8"?>
<!-- Suites de tests Thé Tip Top. Une suite = un stage Jenkins (voir Jenkinsfile). -->
<phpunit bootstrap="tests/bootstrap.php" colors="true" cacheResult="false"
         failOnWarning="true" failOnRisky="true" beStrictAboutTestsThatDoNotTestAnything="true">
  <testsuites>
    <testsuite name="unit"><directory>tests/Unit</directory></testsuite>
    <testsuite name="integration"><directory>tests/Integration</directory></testsuite>
    <testsuite name="api"><directory>tests/Api</directory></testsuite>
    <testsuite name="e2e"><directory>tests/E2E</directory></testsuite>
    <testsuite name="security"><directory>tests/Security</directory></testsuite>
  </testsuites>
</phpunit>
